{
  "name": "wooh-launcher",
  "version": "1.2.5",
  "description": "WoohProject game launcher for Windows (Electron)",
  "main": "src/main/main.js",
  "author": {
    "name": "WoohProject"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --enable-logging",
    "test": "node test/run-tests.js",
    "lint": "eslint .",
    "verify": "npm run lint && npm test",
    "format": "prettier --write \"src/**/*.{js,html,css,json}\" \"test/**/*.js\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,html,css,json}\" \"test/**/*.js\" \"*.mjs\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.3.3"
  },
  "build": {
    "appId": "com.woohproject.launcher",
    "productName": "WoohProject Launcher",
    "copyright": "Copyright © 2026 WoohProject",
    "directories": {
      "output": "../artifacts",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/steamworks.js/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/main/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WoohProject Launcher",
      "uninstallDisplayName": "WoohProject Launcher",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName} ${version}.${ext}"
    }
  }
}
